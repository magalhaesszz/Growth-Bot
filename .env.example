# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=seu_token_aqui
TELEGRAM_OWNER_ID=seu_chat_id_aqui   # /userinfobot no Telegram para descobrir

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_anon_key_aqui

# ─── Criptografia de sessões ─────────────────────────────────
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=chave_fernet_32bytes_aqui

# Instagram
INSTAGRAM_COUNTRY=BR
INSTAGRAM_COUNTRY_CODE=55
INSTAGRAM_LOCALE=pt_BR
INSTAGRAM_TIMEZONE_OFFSET=-10800
# Deixe vazio para usar diretamente o IP da máquina que executa o bot.
INSTAGRAM_PROXY=

# Video API (Railway)
VIDEO_API_URL=https://growth-bot-video-api-production.up.railway.app
VIDEO_API_SECRET=troque_por_um_segredo_forte
# Opcional. Vazio usa a pasta temporária adequada ao sistema operacional.
VIDEO_CONFIG_PATH=
