# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=seu_token_aqui
TELEGRAM_OWNER_ID=seu_chat_id_aqui   # /userinfobot no Telegram para descobrir

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_chave_aqui

# ─── Criptografia de sessões ─────────────────────────────────
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=chave_fernet_32bytes_aqui

# ─── Video API ───────────────────────────────────────────────
VIDEO_API_URL=https://seu-servico.up.railway.app
VIDEO_API_SECRET=troque-por-um-segredo-forte
# Limites de memória do bot (Discloud tem RAM limitada).
VIDEO_MAX_FILE_MB=45
VIDEO_MAX_BATCH_MB=120
# Persistir configuração do editor na tabela video_settings do Supabase.
VIDEO_SETTINGS_REMOTE=true

# ─── Instagram (opcional) ────────────────────────────────────
# Deixe vazio para conexão direta. Não use HTTP_PROXY/HTTPS_PROXY globais.
INSTAGRAM_USE_PROXY=false
INSTAGRAM_PROXY=
INSTAGRAM_COUNTRY=BR
INSTAGRAM_COUNTRY_CODE=55
INSTAGRAM_LOCALE=pt_BR
INSTAGRAM_TIMEZONE_OFFSET=-10800
